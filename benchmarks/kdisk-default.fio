[globals]
; output format
ioengine=libaio
randrepeat=0
refill_buffers
end_fsync=1
direct=1
rwmixread=70
size=1024m
zero_buffers=0
runtime=5
loops=1
numjobs=1

[SEQ1M-Q8T1-READ]
stonewall
bs=1m
iodepth=8
rw=read
[SEQ1M-Q1T1-READ]
stonewall
bs=1m
iodepth=1
rw=read
[RND4K-Q32T1-READ]
stonewall
bs=4k
iodepth=32
rw=randread
[RND4K-Q1T1-READ]
stonewall
bs=4k
iodepth=1
rw=randread

[SEQ1M-Q8T1-WRITE]
stonewall
bs=1m
iodepth=8
rw=write
[SEQ1M-Q1T1-WRITE]
stonewall
bs=1m
iodepth=1
rw=write
[RND4K-Q32T1-WRITE]
stonewall
bs=4k
iodepth=32
rw=randwrite
[RND4K-Q1T1-WRITE]
stonewall
bs=4k
iodepth=1
rw=randwrite
